# Flutter / Dart
.dart_tool/
.packages
.pub-cache/
.pub/
build/
# pubspec.lock для приложения коммитим: без него CI может собрать другой
# набор версий, чем локально, и падение будет невоспроизводимым.
.flutter-plugins
.flutter-plugins-dependencies

# rive_native скачивает нативные библиотеки локально — в репозиторий не кладём
.rive_native/
**/rive_native/

# IDE
.idea/
.vscode/
*.iml
*.ipr
*.iws

# Платформенные папки генерируются `flutter create .` — см. README
# (раскомментировать, если решим не хранить их в репозитории)
# android/
# ios/
# web/
# macos/
# linux/
# windows/

# Скрипты из tool/ импортируются друг другом как модули — Python кладёт рядом
# байт-код, в репозитории он не нужен.
__pycache__/
*.pyc

# OS
.DS_Store
Thumbs.db

# Упакованное в один файл приложение — собирается из build/
teddytales-app*.html
